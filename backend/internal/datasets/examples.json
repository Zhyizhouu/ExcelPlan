  "W1D4": {
    "dataset": "teaching",
    "inputColumns": [
      "Group",
      "Lecturer Type",
      "Workload"
    ],
    "inputNote": "Three columns are enough: Group to bucket by, Lecturer Type to filter, Workload to add up.",
    "task": "Per Group: session count, total workload, VC count, and average workload.",
