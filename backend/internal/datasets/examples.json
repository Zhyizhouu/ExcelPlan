  "W2D1": {
    "dataset": "teaching",
    "inputColumns": [
      "Lecturer Type",
      "Workload"
    ],
    "inputNote": "Convert the range to a Table first (Ctrl+T), then name it tblTeaching.",
    "task": "Rewrite a SUMIFS using structured references instead of A1-style ranges.",
    "result": {
      "columns": [
        "Lecturer Type",
        "Total Workload"
      ],
      "rows": [
        {
          "Lecturer Type": "VC",
          "Total Workload": 58.0
        },
        {
          "Lecturer Type": "Forum",
          "Total Workload": 14.0
        }
      ]
    },
    "resultNote": "The formula stops mentioning cell addresses, so adding rows never breaks it.",
    "formula": "=SUMIFS(tblTeaching[Workload], tblTeaching[Lecturer Type], \"VC\")"
  },
  "W2D2": {
    "dataset": "teaching",
    "inputColumns": [
      "Group",
      "Lecturer Type",
      "Workload"
    ],
    "inputNote": "The allowed values come from the data itself, not from a list you type.",
    "task": "Add list dropdowns for Group and Lecturer Type, and reject Workload outside 0 to 1.",
    "result": {
      "columns": [
        "Field",
        "Rule",
        "Allowed"
      ],
      "rows": [
        {
          "Field": "Group",
          "Rule": "List",
          "Allowed": "G1, G2, G3, G4, G5"
        },
        {
          "Field": "Lecturer Type",
          "Rule": "List",
          "Allowed": "VC, Forum"
        },
        {
          "Field": "Workload",
          "Rule": "Decimal between",
          "Allowed": "0 to 1"
        }
      ]
    },
    "resultNote": "Note the trap: real Workload values reach 2.5, so this rule rejects most of the sheet. That is the lesson \u2014 validation constrains new input, it does not clean existing data.",
    "formula": "Data \u2192 Data Validation \u2192 Allow: List / Decimal"
  },
