# Copy to backend/.env and fill in. backend/.env is gitignored.

# Google AI Studio key for the case tutor: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Newest is usually best, but the very newest flash is often 503 'high
# demand' — this one serves reliably. `gemini-flash-latest` always tracks the
# newest. Unset falls back to gemini-flash-latest.
GEMINI_MODEL=gemini-3.6-flash
